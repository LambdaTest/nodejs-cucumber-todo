{
  "name": "cucumber-js-lambdatest",
  "version": "0.1.0",
  "readme": "Cucumber-JS Integration with lambdatest",
  "description": "Selenium examples for Cucumber-JS and lambdatest Automation",
  "scripts": {
    "test": "npm run single",
    "single": "CONFIG_FILE=single ./node_modules/@cucumber/cucumber/bin/cucumber.js features/todo.feature",
    "local": "CONFIG_FILE=local ./node_modules/@cucumber/cucumber/bin/cucumber.js features/local.feature",
    "parallel": "CONFIG_FILE=parallel ./scripts/cucumber-runner.js features/todo.feature"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "cucumber-assert": "1.0.4",
    "selenium-webdriver": "4.38.0"
  }
}
